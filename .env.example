# ─────────────────────────────────────────────────────────────────────────────
# Hopline settings — template. Copy to `.env` and adjust (`.env` is git-ignored).
# Every setting is optional; the values below are the defaults.
#
# Read automatically by: docker compose, `npm run dev`, `npm start`, the Vite dev server and the desktop app.
# Variables already set in your shell or host (e.g. Render) take precedence over this file.
# Keep comments on their own lines (no "VALUE # comment").
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
# Docker: web app → http://localhost:WEB_PORT
WEB_PORT=8080
# Docker: signaling server (published for the desktop app)
SERVER_PORT=8787
# Without Docker: signaling server (and the web app with `npm start`)
PORT=8787
HOST=0.0.0.0
# Vite dev server (`npm run dev`)
WEB_DEV_PORT=5290
SIGNALING_PROXY_TARGET=http://127.0.0.1:8787

# ── Signaling server ─────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
# pretty | json  (json is the default when NODE_ENV=production)
LOG_FORMAT=pretty
# Rooms nobody joins are removed after this many minutes
ROOM_TTL_MINUTES=30
# How long a device whose connection dropped keeps its place in the room
RECONNECT_GRACE_SECONDS=120
HEARTBEAT_SECONDS=30
MAX_CONNECTIONS_PER_IP=20
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=120
# Comma-separated browser origins allowed to connect; empty = any (needed for the desktop app)
ALLOWED_ORIGINS=
# `npm start` also serves the built web app
SERVE_WEB=true
# true behind a reverse proxy, so per-IP limits see real client IPs (Docker sets this itself)
TRUST_PROXY=false

# ── NAT traversal ────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relay — needed when devices sit on networks that block direct links (mobile carriers, CGNAT,
# corporate Wi-Fi, different countries). See docs/turn.md.
#
# Option A: your own coturn (`docker compose --profile turn up -d`). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Example: TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp
TURN_URLS=
TURN_SECRET=
# The relay host's PUBLIC IP address (coturn advertises it to clients)
TURN_EXTERNAL_IP=
TURN_REALM=hopline
# Credential lifetime in seconds; must outlast your longest transfer
TURN_TTL_SECONDS=43200
# Extra coturn flags. LAN testing only: --allowed-peer-ip=192.168.0.0-192.168.255.255
TURN_EXTRA_ARGS=
#
# Option B: a managed TURN provider with a fixed username/password (leave TURN_SECRET empty)
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Web app (build time) ─────────────────────────────────────────────────────
# Empty = same origin as the page (right for npm run dev, npm start, Docker and Render)
VITE_SIGNALING_URL=
VITE_STUN_URLS=

# ── Desktop app ──────────────────────────────────────────────────────────────
HOPLINE_SIGNALING_URL=ws://localhost:8787/ws
# Set to load the UI from the dev server instead of the build (npm run desktop:dev sets it for you)
HOPLINE_WEB_URL=

# ── CLI ──────────────────────────────────────────────────────────────────────
# (The CLI runs on any computer, so it reads these from that computer's environment, not this file.)
# HOPLINE_DISCOVERY_PORT=41899
# HOPLINE_DEBUG=1
# NO_COLOR=1
