# Rendered by the nginx image at startup: ${SIGNALING_UPSTREAM} comes from the environment.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Hashed build assets are immutable; everything else must be revalidated.
map $uri $hopline_cache_control {
  ~^/assets/  "public, max-age=31536000, immutable";
  default     "no-cache";
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 1k;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Security headers are set ONCE here and no location adds its own: in nginx, any add_header inside a
  # location silently drops all of these for that location.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws: wss: https:; worker-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Cross-Origin-Resource-Policy "same-origin" always;
  add_header Cache-Control $hopline_cache_control always;

  # Only GET/HEAD are meaningful here (WebSocket upgrades are GET).
  if ($request_method !~ ^(GET|HEAD)$) {
    return 405;
  }

  # Signaling WebSocket → Hopline server container.
  location = /ws {
    proxy_pass http://${SIGNALING_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # $http_host keeps the port ("localhost:8080"); the server compares it with the browser's Origin.
    proxy_set_header Host $http_host;
    # Overwrite (not append): the server trusts exactly one hop, so a client can't inject fake addresses.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Server health (proxied) and this container's own health.
  location = /health {
    proxy_pass http://${SIGNALING_UPSTREAM}/health;
    proxy_set_header X-Forwarded-For $remote_addr;
  }
  location = /nginx-health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /assets/ {
    try_files $uri =404;
  }

  # Single-page app: unknown paths serve index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
